{
    "name": "mcdennem/bolt-translations",
    "description": "Manage your site's translations in the Bolt admin, stored in the database.",
    "type": "bolt-extension",
    "license": "MIT",
    "keywords": ["bolt", "extension", "translations"],
    "homepage": "https://github.com/mcdennem/bolt-translations",
    "authors": [
        {
            "name": "Dennis Meiderwijk",
            "homepage": "https://github.com/mcdennem"
        }
    ],
    "support": {
        "issues": "https://github.com/mcdennem/bolt-translations/issues",
        "source": "https://github.com/mcdennem/bolt-translations"
    },
    "require": {
        "php": ">=8.4",
        "bolt/core": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Mcdennem\\BoltTranslations\\": "src/"
        }
    },
    "extra": {
        "entrypoint": "Mcdennem\\BoltTranslations\\Extension"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": false,
            "symfony/flex": false,
            "drupol/composer-packages": false
        }
    }
}
